# -----------------------------------------------------------------------------
# Email quên mật khẩu (API POST /auth/forgot-password)
# -----------------------------------------------------------------------------
# FRONTEND_URL: domain + port của app React nơi user mở link đặt lại mật khẩu
#   (ví dụ khách: http://localhost:5173 — nếu chỉ admin quên mật khẩu qua admin app thì đặt http://localhost:5174)
FRONTEND_URL=http://localhost:5173

# SMTP: bắt buộc có SMTP_HOST, SMTP_USER, SMTP_PASS thì server mới gửi email thật.
# Nếu thiếu: môi trường dev vẫn trả link trên màn hình; production trả lỗi 503.

# --- Gmail (khuyến nghị thử trước) ---
# 1) Bật xác minh 2 bước cho tài khoản Google
# 2) Google Account → Bảo mật → Mật khẩu ứng dụng → tạo mật khẩu 16 ký tự cho "Thư"
# 3) SMTP_USER = địa chỉ Gmail đầy đủ, SMTP_PASS = mật khẩu ứng dụng (không phải mật khẩu đăng nhập thường)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Không cần ngoặc kép quanh email / mật khẩu (tránh lỗi parser)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
# Có khoảng trắng → cần ngoặc kép cả chuỗi
MAIL_FROM="Model Shop <your_email@gmail.com>"

# --- Outlook / Hotmail ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

# --- Gửi qua dịch vụ SMTP khác (SendGrid, Mailgun SMTP, hosting cPanel...) ---
# Xem tài liệu nhà cung cấp: host, port (thường 587 TLS hoặc 465 SSL), user/pass API.
