# ===== Bắt buộc =====
NODE_ENV=development
PORT=5000
# Local: mongodb://127.0.0.1:27017/model_shop  |  Atlas: mongodb+srv://<user>:<password>@<cluster>/model_shop
MONGODB_URI=mongodb://127.0.0.1:27017/model_shop
# Tối thiểu 32 ký tự ngẫu nhiên. Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== Bảo mật / CORS / Cookie đăng nhập (httpOnly) =====
# Danh sách origin của frontend (khách + admin), phân tách bằng dấu phẩy. BẮT BUỘC ở production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5174
# Web khách/admin cùng "site" (vd shop.example.com & admin.example.com) → giữ lax và đặt COOKIE_DOMAIN=.example.com
# Khác site hoàn toàn → COOKIE_SAMESITE=none (bắt buộc HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com
# Đứng sau reverse proxy (Nginx, Render…): số proxy tin cậy
# TRUST_PROXY=1

# ===== Frontend & email quên mật khẩu =====
# URL trang khách (link đặt lại mật khẩu trỏ về đây)
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Model Shop <your_email@gmail.com>"

# ===== Tạo admin đầu tiên: npm run ensure-admin =====
ADMIN_EMAIL=
ADMIN_USERNAME=admin
# Bỏ trống → sinh mật khẩu ngẫu nhiên và in ra một lần
ADMIN_PASSWORD=

# ===== Tuỳ chọn =====
# DNS_SERVERS=1.1.1.1,1.0.0.1
