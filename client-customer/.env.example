# URL API (server Express)
NEXT_PUBLIC_API_URL=http://localhost:5000
# URL trang admin (link "Admin dashboard" và chuyển hướng sau khi admin đăng nhập)
NEXT_PUBLIC_ADMIN_URL=http://localhost:5174
# Host ảnh được tối ưu bởi next/image (phân tách bằng dấu phẩy); ảnh host khác vẫn hiển thị nhưng không tối ưu
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com
