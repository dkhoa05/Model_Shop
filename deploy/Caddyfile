# Caddy tự động lấy/gia hạn chứng chỉ HTTPS (Let's Encrypt) cho 3 domain.
{$SHOP_DOMAIN} {
	encode zstd gzip
	reverse_proxy customer:3000
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:80
}

{$API_DOMAIN} {
	encode zstd gzip
	# Ảnh tải lên nằm trong volume của API và được phục vụ qua /uploads
	reverse_proxy api:5000
}
