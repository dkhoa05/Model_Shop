# Sao chép thành .env.production (KHÔNG commit) rồi điền giá trị thật.
# Chạy: docker compose --env-file .env.production up -d --build

# --- Domain (cả 3 phải trỏ DNS về máy chủ) ---
SHOP_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
# Cookie đăng nhập dùng chung cho các subdomain cùng site (khuyến nghị): .example.com
COOKIE_DOMAIN=.example.com

# --- Bảo mật ---
# Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Email (quên mật khẩu, xác nhận đơn, thông báo trạng thái) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Model Shop <no-reply@example.com>"

# --- Cửa hàng ---
SHIPPING_FLAT_FEE=30000
FREE_SHIPPING_THRESHOLD=500000
STORE_PICKUP_ADDRESS="Nhận tại cửa hàng — 123 Đường ABC, Quận 1, TP.HCM (09:00–21:00)"

LOG_LEVEL=info
